datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DemoRequest {
  company       String?
  createdAt     DateTime @default(now())
  email         String?
  id            String   @id @default(cuid())
  message       String?
  name          String?
  phone         String?
  preferredTime String?
  updatedAt     DateTime @updatedAt
}

model User {
  company            String?
  createdAt          DateTime @default(now())
  email              String?  @unique
  firstName          String?
  id                 String   @id @default(cuid())
  lastName           String?
  organizationDomain String?
  password           String
  roles              Json
  updatedAt          DateTime @updatedAt
  username           String   @unique
}
